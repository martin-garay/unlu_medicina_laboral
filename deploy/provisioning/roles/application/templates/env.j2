APP_NAME="Medicina Laboral"
APP_ENV=production
APP_KEY={{ vault_app_key | to_json }}
APP_DEBUG=false
APP_URL={{ application_url }}

LOG_CHANNEL=daily
LOG_LEVEL={{ application_log_level }}

DB_CONNECTION=pgsql
DB_HOST={{ application_db_host }}
DB_PORT={{ application_db_port }}
DB_DATABASE={{ postgresql_database_name }}
DB_USERNAME={{ postgresql_application_user }}
DB_PASSWORD={{ vault_postgresql_password | to_json }}
DB_SSLMODE=prefer

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

BACKOFFICE_LOCAL_ADMIN_ENABLED={{ application_backoffice_admin_enabled | bool | ternary('true', 'false') }}
BACKOFFICE_LOCAL_ADMIN_NAME={{ application_backoffice_admin_name | to_json }}
BACKOFFICE_LOCAL_ADMIN_EMAIL={{ application_backoffice_admin_email | to_json }}
BACKOFFICE_LOCAL_ADMIN_PASSWORD={{ application_backoffice_admin_password | to_json }}
BACKOFFICE_LOCAL_ADMIN_ROLE={{ application_backoffice_admin_role | to_json }}

WHATSAPP_TOKEN={{ vault_whatsapp_token | to_json }}
WHATSAPP_PHONE_ID={{ vault_whatsapp_phone_id | to_json }}
WHATSAPP_VERIFY_TOKEN={{ vault_whatsapp_verify_token | to_json }}

MEDICINA_LABORAL_MAIL_DRIVER="null"
MEDICINA_LABORAL_STORAGE_DRIVER=metadata

# Keep daily log files writable by both PHP-FPM (www-data) and the deploy user.
LOG_FILE_PERMISSION="0664"
