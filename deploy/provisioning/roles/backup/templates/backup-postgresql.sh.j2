#!/bin/sh
set -eu
umask 077
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
root={{ backup_root | quote }}/postgresql
daily="$root/daily/{{ postgresql_database_name }}-$stamp.dump"
runuser -u postgres -- pg_dump --format=custom {{ postgresql_database_name | quote }} > "$daily"
sha256sum "$daily" > "$daily.sha256"
if [ "$(date -u +%u)" = 7 ]; then cp -p "$daily" "$root/weekly/"; cp -p "$daily.sha256" "$root/weekly/"; fi
if [ "$(date -u +%d)" = 01 ]; then cp -p "$daily" "$root/monthly/"; cp -p "$daily.sha256" "$root/monthly/"; fi
find "$root/daily" -type f -mtime +{{ backup_daily_retention_days }} -delete
find "$root/weekly" -type f -mtime +{{ backup_weekly_retention_days }} -delete
find "$root/monthly" -type f -mtime +{{ backup_monthly_retention_days }} -delete
