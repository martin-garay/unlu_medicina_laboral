#!/usr/bin/env bash

set -euo pipefail

provisioning_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
deploy_dir="$(cd "${provisioning_dir}/.." && pwd)"
venv_dir="${deploy_dir}/.tools/ansible-control-venv"

python_bin="${MEDICINA_CONTROL_PYTHON:-}"

if [[ -z "${python_bin}" ]]; then
    for candidate in python3.12 python3.11 python3.10 python3.9 python3.8 python3; do
        if command -v "${candidate}" >/dev/null 2>&1; then
            python_bin="${candidate}"
            break
        fi
    done
fi

if [[ -z "${python_bin}" ]]; then
    echo "No Python 3 interpreter found for the Ansible control node." >&2
    exit 1
fi

python_version="$(
    "${python_bin}" - <<'PY'
import sys
print(f"{sys.version_info.major}.{sys.version_info.minor}")
PY
)"

"${python_bin}" - <<'PY'
import sys

if sys.version_info < (3, 8):
    raise SystemExit("Python >= 3.8 is required for the Ansible control venv")
PY

mkdir -p "${deploy_dir}/.tools"
"${python_bin}" -m venv "${venv_dir}"

export PYTHONNOUSERSITE=1
"${venv_dir}/bin/python" -m pip install --upgrade pip wheel
"${venv_dir}/bin/python" -m pip install -r "${provisioning_dir}/requirements-control.txt"

export ANSIBLE_HOME="${deploy_dir}/.tools/ansible-home"
export ANSIBLE_LOCAL_TEMP="${TMPDIR:-/tmp}/medicina-laboral-ansible-local"
export ANSIBLE_COLLECTIONS_PATH="${deploy_dir}/.tools/ansible-collections"
export XDG_CACHE_HOME="${deploy_dir}/.tools/cache"
mkdir -p \
    "${ANSIBLE_HOME}" \
    "${ANSIBLE_LOCAL_TEMP}" \
    "${ANSIBLE_COLLECTIONS_PATH}" \
    "${XDG_CACHE_HOME}"

"${venv_dir}/bin/ansible-galaxy" collection install \
    -r "${provisioning_dir}/requirements.yml" \
    -p "${ANSIBLE_COLLECTIONS_PATH}"

echo "Control node ready."
echo "Python: ${python_bin} (${python_version})"
echo "Venv: ${venv_dir}"
echo
echo "Use one of:"
echo "  export PATH=\"${provisioning_dir}/bin:\$PATH\""
echo "  bin/ansible-playbook -i inventories/testing/hosts.yml site.yml --check --diff"
